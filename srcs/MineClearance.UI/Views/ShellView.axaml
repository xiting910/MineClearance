<UserControl x:Class="MineClearance.UI.Views.ShellView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MineClearance.UI.ViewModels"
             xmlns:views="using:MineClearance.UI.Views"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource WindowBackgroundBrush}">

  <Panel>

    <!-- 背景图片: 最底层, 三个视图之下显示, 未设置时透明露出主题背景色 -->
    <Image Source="{Binding BackgroundImage}" Stretch="{Binding BackgroundImageStretch}"
           Opacity="{Binding BackgroundImageOpacity}"/>

    <!-- 三个视图常驻可视树, 通过宿主层切换可见性, 避免每次切换重建视图与棋盘控件 -->
    <Panel IsVisible="{Binding IsMainViewVisible}">
      <views:MainView DataContext="{Binding Main}"/>
    </Panel>

    <!-- 游戏视图常驻布局 (启动预热棋盘控件) -->
    <Panel Opacity="{Binding GameViewOpacity}" IsHitTestVisible="{Binding IsGameViewVisible}"
           IsEnabled="{Binding IsGameViewVisible}">
      <views:GameView DataContext="{Binding Game}"/>
    </Panel>

    <!-- 历史记录视图常驻布局 (预热 DataGrid 等重控件) -->
    <Panel Opacity="{Binding HistoryViewOpacity}" IsHitTestVisible="{Binding IsHistoryViewVisible}"
           IsEnabled="{Binding IsHistoryViewVisible}">
      <views:HistoryView DataContext="{Binding History}"/>
    </Panel>

    <!-- 共用遮布: 设置抽屉或下载抽屉打开时淡入, 点击收起当前抽屉 -->
    <Border IsVisible="{Binding IsMaskVisible}" Opacity="{Binding MaskOpacity}"
            Background="#66000000" PointerPressed="OnMaskPressed">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- 设置抽屉: 左侧面板, 打开滑入淡入, 关闭滑出淡出, 可拖动右边界调整宽度 -->
    <Border IsVisible="{Binding IsSettingsVisible}" Opacity="{Binding SettingsOpacity}"
            Background="{DynamicResource WindowBackgroundBrush}"
            HorizontalAlignment="Left" Width="{Binding SettingsDrawerWidth}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Border.Transitions>
      <Border.RenderTransform>
        <TranslateTransform X="{Binding SettingsSlideOffset}">
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Border.RenderTransform>
      <Grid>
        <ContentControl Content="{Binding Settings}"/>
        <!-- 右边界拖动手柄: 拖动调整抽屉宽度, 不保存 -->
        <Border Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent"
                Cursor="SizeWestEast"
                PointerPressed="OnSettingsResizePressed"
                PointerMoved="OnSettingsResizeMoved"
                PointerReleased="OnSettingsResizeReleased"/>
      </Grid>
    </Border>

    <!-- 下载进度悬浮球: 左下角, 下载时出现 -->
    <views:DownloadBallView DataContext="{Binding Update}"/>

    <!-- 下载详情抽屉: 左侧面板, 层级位于设置抽屉之上 -->
    <views:DownloadDrawerView DataContext="{Binding Update}"/>

    <!-- 全局 Toast 通知 -->
    <views:ToastView DataContext="{Binding Toast}"/>

  </Panel>

</UserControl>
