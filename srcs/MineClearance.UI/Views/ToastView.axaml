<UserControl x:Class="MineClearance.UI.Views.ToastView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MineClearance.UI.ViewModels"
             xmlns:models="using:MineClearance.UI.Models"
             x:DataType="vm:ToastViewModel"
             IsVisible="{Binding HasItems}"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Margin="0,0,16,16">

  <!-- 多条提示纵向堆叠, 最新条目在下方, 每条独立计时与悬停暂停 -->
  <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" HorizontalAlignment="Right"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:ToastItem">
        <Border Padding="12,8" CornerRadius="6"
                Background="{DynamicResource ToastBackgroundBrush}" BoxShadow="0 4 12 0 #33000000"
                Opacity="{Binding EnterOpacity}"
                PointerEntered="OnToastPointerEntered"
                PointerExited="OnToastPointerExited"
                Tapped="OnToastTapped">

          <!-- 入场动画: 透明度从 0 淡入, 位移从下方 16px 滑入, 由视图模型在加入后下一帧触发 -->
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
          </Border.Transitions>
          <Border.RenderTransform>
            <TranslateTransform Y="{Binding EnterOffset}">
              <TranslateTransform.Transitions>
                <Transitions>
                  <DoubleTransition Property="Y" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
              </TranslateTransform.Transitions>
            </TranslateTransform>
          </Border.RenderTransform>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Feedback}" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="400"/>

            <!-- 剩余时间进度条: 前景条按剩余比例从满宽缩至零, 线性过渡补间保证平滑缩短, 鼠标悬停时倒计时暂停进度条也停住 -->
            <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF">
              <Border CornerRadius="1.5" Background="{DynamicResource ToastProgressBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="{Binding Progress}" ScaleY="1">
                    <ScaleTransform.Transitions>
                      <Transitions>
                        <!-- 过渡时长略大于刷新间隔, 每次进度更新都连续补间而非跳变 -->
                        <DoubleTransition Property="ScaleX" Duration="0:0:0.06"/>
                      </Transitions>
                    </ScaleTransform.Transitions>
                  </ScaleTransform>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0,0.5</Border.RenderTransformOrigin>
              </Border>
            </Border>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
