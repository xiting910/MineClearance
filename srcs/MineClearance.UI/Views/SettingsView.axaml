<UserControl x:Class="MineClearance.UI.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MineClearance.UI.ViewModels"
             xmlns:models="using:MineClearance.UI.Models"
             xmlns:shared="using:MineClearance.UI"
             xmlns:media="using:Avalonia.Media"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource WindowBackgroundBrush}">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">

      <!-- 标题与关闭按钮 -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TitleForegroundBrush}"/>
        <Button Grid.Column="1" Content="✕" Click="OnCloseClick" Padding="10,4"
                Background="{DynamicResource DangerButtonBackgroundBrush}" Foreground="{DynamicResource DangerButtonForegroundBrush}"/>
      </Grid>

      <!-- UI 配置 (主题/Toast 时长与数量/悬浮球) -->
      <TextBlock Text="UI 配置" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="主题:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                  ToolTip.Tip="切换界面配色模式">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:ThemeMode">
              <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="1" Text="背景来源:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding UseCustomBackgroundImage}"
                  Content="使用自定义背景图片" VerticalAlignment="Center"
                  ToolTip.Tip="勾选后从自定义图片文件夹选择图片, 取消勾选使用内置背景图片"/>
        <TextBlock Grid.Row="2" Text="背景图片:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding BackgroundImages}" SelectedItem="{Binding SelectedBackgroundImage}"
                  PlaceholderText="选择背景图片"
                  ToolTip.Tip="根据上方开关选择内置或自定义图片, 在自定义图片文件夹放入新图片后点击刷新按钮或者重新打开设置即可识别">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:BackgroundImageOption">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="3" Text="背景拉伸:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding StretchModes}" SelectedItem="{Binding BackgroundImageStretch}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="media:Stretch">
              <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="None - 保持原尺寸"/>
              <TextBlock Text="Fill - 拉伸填满"/>
              <TextBlock Text="Uniform - 等比缩放"/>
              <TextBlock Text="UniformToFill - 等比缩放裁剪填满"/>
            </StackPanel>
          </ToolTip.Tip>
        </ComboBox>
        <TextBlock Grid.Row="4" Text="背景透明度:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Slider Grid.Row="4" Grid.Column="1" Value="{Binding BackgroundImageOpacity}"
                Minimum="0" Maximum="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                ToolTip.Tip="滑动调节背景图片的透明度"/>
        <TextBlock Grid.Row="5" Grid.RowSpan="2" Text="操作:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Grid.Row="5" Grid.Column="1" Content="刷新背景图片" Command="{Binding RefreshBackgroundImagesCommand}"
                HorizontalAlignment="Stretch" Padding="12,6"
                ToolTip.Tip="重新扫描可用的图片列表并重新加载当前选择的背景图片"
                Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>
        <Button Grid.Row="6" Grid.Column="1" Content="创建并打开自定义图片文件夹" Command="{Binding OpenCustomBackgroundImagesFolderCommand}"
                HorizontalAlignment="Stretch" Padding="12,6"
                ToolTip.Tip="{x:Static shared:Constants.CustomBackgroundImageDirectory}"
                Background="{DynamicResource NeutralButtonBackgroundBrush}" Foreground="{DynamicResource NeutralButtonForegroundBrush}"/>
        <TextBlock Grid.Row="7" Text="Toast 显示时间 (秒):" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding ToastDurationSeconds}"
                       Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0"
                       ToolTip.Tip="右下角提示的显示时间 (秒)"/>
        <TextBlock Grid.Row="8" Text="Toast 数量:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding MaxToastCount}"
                       Minimum="1" Maximum="5" Increment="1" FormatString="0"
                       ToolTip.Tip="右下角提示的同时显示最大条数"/>
        <TextBlock Grid.Row="9" Text="下载悬浮球:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding ShowDownloadBall}"
                  Content="下载时在左下角显示进度悬浮球" VerticalAlignment="Center"
                  ToolTip.Tip="下载更新时是否在左下角显示进度悬浮球"/>
        <TextBlock Grid.Row="10" Text="首点复制索引:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding CopyIndexOnFirstClick}"
                  Content="首次点击格子时复制索引到剪贴板" VerticalAlignment="Center"
                  ToolTip.Tip="将游戏开始时首次点击的格子索引复制到剪贴板并提示"/>
        <TextBlock Grid.Row="11" Text="显示索引快捷键:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Grid.Row="11" Grid.Column="1" Content="{Binding HotkeyButtonText}"
                Command="{Binding BeginListenHotkeyCommand}" HorizontalAlignment="Stretch" Padding="12,6"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="点击后按下按键设置热键, Backspace/Delete 清除, 游戏等待开始时按住显示格子索引"/>
      </Grid>

      <Separator/>

      <!-- 日志 -->
      <TextBlock Text="日志" FontWeight="Bold"
                 Foreground="{DynamicResource VioletLabelBrush}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Text="日志级别:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"
                  ToolTip.Tip="写入日志文件的最低日志级别"/>
        <TextBlock Grid.Row="1" Text="操作:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Grid.Row="1" Grid.Column="1" Content="打开日志文件夹" Command="{Binding OpenLogsFolderCommand}"
                HorizontalAlignment="Stretch" Padding="12,6"
                ToolTip.Tip="{x:Static vm:SettingsViewModel.LogsFolderPath}"
                Background="{DynamicResource InfoButtonBackgroundBrush}" Foreground="{DynamicResource InfoButtonForegroundBrush}"/>
      </Grid>

      <Separator/>

      <!-- 更新 -->
      <TextBlock Text="更新" FontWeight="Bold"
                 Foreground="{DynamicResource GreenLabelBrush}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Grid.RowSpan="2" Text="操作:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Button Grid.Column="1" Content="检查更新" Command="{Binding CheckForUpdatesCommand}"
                HorizontalAlignment="Stretch" Padding="12,6"
                ToolTip.Tip="检查 GitHub 上是否有新版本"
                Background="{DynamicResource SuccessButtonBackgroundBrush}" Foreground="{DynamicResource SuccessButtonForegroundBrush}"/>
        <Button Grid.Row="1" Grid.Column="1" Content="清除更新缓存" Command="{Binding ClearUpdateCacheCommand}"
                HorizontalAlignment="Stretch" Padding="12,6"
                ToolTip.Tip="更新过程中或者下载完成等待重启更新时请勿清理缓存"
                Background="{DynamicResource AccentButtonBackgroundBrush}" Foreground="{DynamicResource AccentButtonForegroundBrush}"/>
      </Grid>

      <Separator/>

      <!-- 关于 -->
      <TextBlock Text="关于" FontWeight="Bold"
                 Foreground="{DynamicResource RedLabelBrush}"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
        <TextBlock Text="产品:" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding Product}"/>
        <TextBlock Grid.Row="1" Text="版本:" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}"/>
        <TextBlock Grid.Row="2" Text="作者:" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Authors}"/>
        <TextBlock Grid.Row="3" Text="许可证:" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding License}"/>
        <TextBlock Grid.Row="4" Text="GitHub:" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GitHubUrl}"
                   Foreground="{DynamicResource TitleForegroundBrush}" TextDecorations="Underline"
                   Cursor="Hand" VerticalAlignment="Center" PointerPressed="OnGitHubLinkPressed"/>
      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>
